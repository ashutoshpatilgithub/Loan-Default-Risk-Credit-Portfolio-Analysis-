      </column>
      <column caption='MoM Loan Applications' datatype='real' name='[Calculation_0288399329779715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0288399328956417] - [Calculation_0288399329554434])&#13;&#10;/&#13;&#10;[Calculation_0288399329554434]' />
